# ==========================================
# LEXO — Configuración de entorno
# Copiá este archivo como ".env" y completá tus datos.
# ==========================================

APP_NAME="LEXO"
APP_ENV="local"
APP_URL="http://127.0.0.1:8000"
APP_TIMEZONE="UTC"
APP_DEBUG="true"

# Base de datos:
# - En local rápido podés usar "sqlite" (crea storage/lexo.sqlite automáticamente)
# - En Hostinger usá "mysql" con los datos de hPanel -> Bases de datos MySQL
DB_DRIVER="sqlite"
DB_SQLITE_PATH="storage/lexo.sqlite"

DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="u123456789_lexo"
DB_USERNAME="u123456789_lexo_user"
DB_PASSWORD=""

# Google OAuth 2.0 / OpenID Connect (Google Cloud Console)
# URI de redirección autorizada: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
